# Modelo local. Nunca coloque valores reais ou segredos no GitHub.
# Na hospedagem, cadastre estes campos nas variáveis de ambiente do provedor.

# --- Banco MySQL ---
MYSQL_USER=sesi_app
MYSQL_PASSWORD=coloque_uma_senha_forte_aqui
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=sesi_gestao
# Ative no banco gerenciado em cloud; localmente deixe false.
MYSQL_SSL=false
# Opcional: caminho do certificado CA ou o conteúdo PEM fornecido pelo provedor.
MYSQL_SSL_CA=
# Alternativa: URL de conexão mysql://... disponibilizada pelo provedor.
# Se usar DATABASE_URL, ela tem prioridade sobre MYSQL_USER/HOST/PASSWORD.
DATABASE_URL=

# --- Sessões ---
# Gere uma chave aleatória e mantenha-a fixa entre reinicializações.
JWT_SECRET_KEY=gere_uma_chave_aleatoria_longa_e_exclusiva
JWT_EXPIRE_MINUTES=480

# --- Primeiro administrador ---
# Só usada na criação inicial do banco. Deixe vazia para gerar senha aleatória.
ADMIN_DEFAULT_PASSWORD=

# Abrir navegador automaticamente só faz sentido na execução local.
OPEN_BROWSER=true
